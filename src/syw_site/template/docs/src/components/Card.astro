---
// The paper's card from nstarkman.space, once its record exists there (website_id in syw-site.yml).
import { facts } from '../lib/facts.js';
---
{facts.website_id && (
  <iframe class="syw-card" src={`https://nstarkman.space/embed/${facts.website_id}/`} title="This paper on nstarkman.space" height="320" loading="lazy"></iframe>
)}
