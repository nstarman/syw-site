---
// An interactive figure (a figpress-apps app listed in docs/syw-site.yml): <Webapp name="globe" />, with its
// caption, if any, as the content: <Webapp name="globe">Caption.</Webapp>.
import { url, webapp } from '../lib/facts.js';

const { name, height = 640 } = Astro.props;
webapp(name);
const site = url(`generated/webapps/${name}/site/`);
---
<figure class="syw-webapp">
  {/* `height` until the app loads; then the frame follows the app's own height (same origin). */}
  <iframe src={site} title={`Interactive figure: ${name}`} height={height} loading="lazy" data-fit></iframe>
  <figcaption>
    <slot />
    {/* As under a paper figure: the page on the left, the download on the right. */}
    <div class="fig-links">
      <span><a href={site}>More</a></span>
      <span><a href={url(`generated/webapps/${name}/${name}.html`)} download>Download HTML</a></span>
    </div>
  </figcaption>
</figure>

<script>
  // Size each app's frame to its content, and again whenever its layout changes (a narrower page
  // stacks the panels under the globe). The frame follows the site's theme toggle: the page's
  // `data-theme` (unset: the system's) is copied onto the app's document, as it changes.
  const root = document.documentElement;
  for (const frame of document.querySelectorAll<HTMLIFrameElement>('iframe[data-fit]')) {
    frame.addEventListener('load', () => {
      const doc = frame.contentDocument;
      if (!doc?.body) return;
      const body = doc.body;
      const fit = () => { frame.style.height = `${Math.ceil(body.getBoundingClientRect().height)}px`; };
      new ResizeObserver(fit).observe(body);
      fit();
      const theme = () => {
        if (root.dataset.theme) doc.documentElement.dataset.theme = root.dataset.theme;
        else delete doc.documentElement.dataset.theme;
      };
      new MutationObserver(theme).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
      theme();
    });
  }
</script>
