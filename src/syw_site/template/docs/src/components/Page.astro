---
// Every page of the docs site: the website's layout; the paper's entry as nstarkman.space
// draws it (the website's own Publication, from card.json), or its title before it has a
// record there (with its authors, from the paper); then the tabs. MDX pages use it as `layout:` in their frontmatter.
import SiteLayout from '@nstarkman/site-layout/SiteLayout.astro';
import Publication from '@nstarkman/research-kit/Publication.astro';
import Authors from './Authors.astro';
import 'katex/dist/katex.min.css';
import { facts, url } from '../lib/facts.js';
import { tex } from '../lib/tex.js';
import { card, resolve, root } from '../lib/store.js';
import { tabs } from '../lib/tabs.js';

const { title, frontmatter, tab = frontmatter?.tab ?? 'overview' } = Astro.props;
const heading = title ?? frontmatter?.title;
const paper = facts.title.replace(/\$[^$]*\$/g, '').replace(/\\[A-Za-z]+|[{}]/g, '').trim();
const item = root && resolve(root);
---
<SiteLayout title={heading ? `${heading} — ${paper}` : paper} section="/research/" repo={facts.repo}>
  <main class="wrap syw">
    {item ? <Publication item={item} abstract card={card.preset} /> : <><h1 class="syw-title" set:html={tex(facts.title)} /><Authors /></>}
    {/* Not <nav>: the website's stylesheet makes every nav its sticky header. */}
    <div class="syw-tabs" role="navigation" aria-label="This paper">
      {tabs().map((t) => <a class:list={['toolsbtn', t.key === tab && 'on']} href={url(t.href)} aria-current={t.key === tab ? 'page' : undefined}>{t.label}</a>)}
    </div>
    {heading && <h2 class="syw-heading">{heading}</h2>}
    <slot />
  </main>
</SiteLayout>

<style is:global>
  .syw { padding-block: 2rem 4rem; }
  .syw-tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 1.25rem; }
  .syw figure { margin: 2rem 0; }
  .syw figure img { max-width: 100%; height: auto; background: #fff; }
  .syw figcaption { font-size: .92em; }
  .syw .syw-figures { display: flex; flex-direction: column; gap: 1rem; }
  .syw iframe { width: 100%; border: 0; }
  .syw pre { overflow-x: auto; }
</style>
