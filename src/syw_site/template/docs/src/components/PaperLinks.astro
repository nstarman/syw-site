---
import { facts } from '../lib/facts.js';

const { arxiv, doi, bibcode } = facts.paper;
const links = [
  arxiv && ['arXiv', `https://arxiv.org/abs/${arxiv}`],
  doi && ['Journal', `https://doi.org/${doi}`],
  bibcode && ['ADS', `https://ui.adsabs.harvard.edu/abs/${bibcode}`],
  ['Code and data', `https://github.com/${facts.repo}`],
].filter(Boolean);
---
<p class="syw-links">
  {links.map(([label, href], i) => <>{i > 0 && ' · '}<a href={href}>{label}</a></>)}
</p>
