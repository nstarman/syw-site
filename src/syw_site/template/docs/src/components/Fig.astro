---
// A figure of the paper with its caption: <Fig label="fig:quadrupole" />. `link` adds a link to
// its own page, and to its interactive version where a webapp in syw-site.yml names it. `image={false}`
// leaves out the image (its page, where a webapp replaces it); `app` (that webapp's name) then puts the
// app's links in this row: More (its own page) on the left, its HTML with the downloads.
import { facts, figure, url } from '../lib/facts.js';
import { tex } from '../lib/tex.js';

const { label, link = true, image = true, app } = Astro.props;
const fig = figure(label);
const number = facts.figures.indexOf(fig) + 1;
const refs = Object.fromEntries(facts.figures.map((f, i) => [f.label, String(i + 1)]));
// It has an interactive counterpart: a webapp in syw-site.yml names it (its page shows it).
const interactive = link && Object.values(facts.webapps ?? {}).some((w) => w.figure && (w.figure === fig.label || w.figure === fig.slug));
const alt = `Paper Figure ${number}: ${fig.caption.replace(/\$[^$]*\$|\\[A-Za-z]+|[{}]/g, '').slice(0, 200)}`;
---
<figure id={fig.slug}>
  {image && fig.images.map((im) => (
    <img src={url(`generated/figures/${im.webp ?? im.png ?? im.file}`)} alt={alt} loading="lazy" />
  ))}
  <figcaption>
    <strong>Paper Figure {number}.</strong> <span set:html={tex(fig.caption, refs)} />
    {/* The links on a line of their own, under the caption: pages on the left, downloads on the right. */}
    <div class="fig-links">
      <span>
        {[
          ...(interactive ? [<a href={url(`figures/${fig.slug}/`)}>Interactive</a>] : []),
          ...(link ? [<a href={url(`figures/${fig.slug}/`)}>More</a>] : []),
          ...(app ? [<a href={url(`generated/webapps/${app}/site/`)}>More</a>] : []),
        ].map((a, i) => <>{i > 0 && ' · '}{a}</>)}
      </span>
      <span>
        {/* "Download HTML · PDF · PNG": the word once, each format its own link. */}
        {[
          ...(app ? [<a href={url(`generated/webapps/${app}/${app}.html`)} download>HTML</a>] : []),
          ...fig.images.filter((im) => im.file.endsWith('.pdf')).map((im) => <a href={url(`generated/figures/${im.file}`)}>PDF</a>),
          ...fig.images.filter((im) => im.png).map((im) => <a href={url(`generated/figures/${im.png}`)} download>PNG</a>),
        ].map((a, i) => <>{i > 0 ? ' · ' : 'Download '}{a}</>)}
      </span>
    </div>
  </figcaption>
</figure>
