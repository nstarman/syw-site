---
import Page from '../../components/Page.astro';
import Fig from '../../components/Fig.astro';
import Webapp from '../../components/Webapp.astro';
import { facts, url } from '../../lib/facts.js';

export function getStaticPaths() {
  return facts.figures.map((f) => ({ params: { slug: f.slug }, props: { fig: f } }));
}
const { fig } = Astro.props;
const number = facts.figures.indexOf(fig) + 1;
const apps = Object.entries(facts.webapps ?? {}).filter(([, w]) => w.figure && w.figure === fig.label);
// A webapp with `replaces: true` stands in for the static image here; the caption and downloads stay.
const replaced = apps.some(([, w]) => w.replaces);
---
<Page title={`Paper Figure ${number}`} tab="figures">
  <a class="syw-back" href={url('figures/')}>← All figures</a>
  {apps.map(([name]) => <Webapp name={name} />)}
  <Fig label={fig.slug} link={false} image={!replaced} />
</Page>
