---
import Page from '../../components/Page.astro';
import Fig from '../../components/Fig.astro';
import Webapp from '../../components/Webapp.astro';
import { facts } from '../../lib/facts.js';

export function getStaticPaths() {
  return facts.figures.map((f) => ({ params: { slug: f.slug }, props: { fig: f } }));
}
const { fig } = Astro.props;
const number = facts.figures.indexOf(fig) + 1;
const apps = Object.entries(facts.webapps ?? {}).filter(([, w]) => w.figure && w.figure === fig.label).map(([name]) => name);
---
<Page title={`Paper Figure ${number}`} tab="figures">
  {apps.map((name) => <Webapp name={name} />)}
  <Fig label={fig.slug} link={false} />
</Page>
